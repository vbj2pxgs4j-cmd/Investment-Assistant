# ==============================================================================
# Mutual Fund FAQ Assistant - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list)
ALLOW_ORIGINS=["*"]

# Groq API Configuration (LPU Inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Corpus & Vector Store Paths (Relative to repository root)
DATA_SOURCE_PATH=data/processed/schemes.json
VECTOR_STORE_PATH=data/vector_store
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Guardrail & Formatting Constraints
MAX_SENTENCE_LIMIT=3
DEFAULT_DISCLAIMER="Facts-only. No investment advice."
WHITELISTED_DOMAIN=groww.in
